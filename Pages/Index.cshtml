@page
@model IndexModel

@section Styles {
    <link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = "Home";
}

<!-- =========================
     HERO SECTION
========================= -->
<section class="ss-hero">
    <div class="container">
        <div class="ss-hero-content">

            <span class="ss-hero-badge">EVERYTHING AUTOMOTIVE</span>

            <h1>
                Your Car.<br />
                <span>Your Journey.</span>
            </h1>

            <p>
                From buying and selling vehicles to servicing, parts, tyres
                and bodywork — SSAutonation brings everything automotive
                together in one place.
            </p>

            <div class="ss-hero-buttons">
                <a href="#services" class="btn ss-btn-primary">
                    Explore Services
                </a>

                <a href="#about" class="btn ss-btn-outline">
                    Discover SSAutonation
                </a>
            </div>

        </div>
    </div>
</section>


<!-- =========================
     SERVICES SECTION
========================= -->
<section id="services" class="ss-services-section">

    <div class="container">

        <div class="ss-section-heading">
            <span>WHAT WE DO</span>
            <h2>Everything Automotive</h2>
            <p>
                One destination for all your automotive needs.
            </p>
        </div>


        <div class="row g-4">

            <!-- Auto Traders -->
            <div class="col-md-6 col-lg-4">
                <div class="ss-service-card">

                    <div class="ss-service-image">
                        <img src="~/img/services/auto-traders.png"
                             alt="Auto Traders" />
                    </div>

                    <div class="ss-service-content">
                        <h3>Auto Traders</h3>

                        <p>
                            Buy and sell vehicles with confidence.
                        </p>

                        <a href="#" class="ss-service-link">
                            Explore Auto Traders →
                        </a>
                    </div>

                </div>
            </div>


            <!-- Auto Parts -->
            <div class="col-md-6 col-lg-4">
                <div class="ss-service-card">

                    <div class="ss-service-image">
                        <img src="~/img/services/auto-parts.png"
                             alt="Auto Parts" />
                    </div>

                    <div class="ss-service-content">
                        <h3>Auto Parts</h3>

                        <p>
                            Genuine and aftermarket parts for your vehicle.
                        </p>

                        <a href="#" class="ss-service-link">
                            Explore Auto Parts →
                        </a>
                    </div>

                </div>
            </div>


            <!-- Auto Services -->
            <div class="col-md-6 col-lg-4">
                <div class="ss-service-card">

                    <div class="ss-service-image">
                        <img src="~/img/services/auto-services.png"
                             alt="Auto Services" />
                    </div>

                    <div class="ss-service-content">
                        <h3>Auto Services</h3>

                        <p>
                            Professional servicing, maintenance and repairs.
                        </p>

                        <a href="#" class="ss-service-link">
                            Explore Auto Services →
                        </a>
                    </div>

                </div>
            </div>


            <!-- Auto Magazine -->
            <div class="col-md-6 col-lg-4">
                <div class="ss-service-card">

                    <div class="ss-service-image">
                        <img src="~/img/services/auto-magazine.png"
                             alt="Auto Magazine" />
                    </div>

                    <div class="ss-service-content">
                        <h3>Auto Magazine</h3>

                        <p>
                            Automotive news, reviews, guides and insights.
                        </p>

                        <a href="#" class="ss-service-link">
                            Read Auto Magazine →
                        </a>
                    </div>

                </div>
            </div>


            <!-- Tyres -->
            <div class="col-md-6 col-lg-4">
                <div class="ss-service-card">

                    <div class="ss-service-image">
                        <img src="~/img/services/tyres.png"
                             alt="Tyres" />
                    </div>

                    <div class="ss-service-content">
                        <h3>Tyres</h3>

                        <p>
                            Tyre fitting, balancing and replacement services.
                        </p>

                        <a href="#" class="ss-service-link">
                            Explore Tyres →
                        </a>
                    </div>

                </div>
            </div>


            <!-- Denting & Painting -->
            <div class="col-md-6 col-lg-4">
                <div class="ss-service-card">

                    <div class="ss-service-image">
                        <img src="~/img/services/denting-painting.png"
                             alt="Denting and Painting" />
                    </div>

                    <div class="ss-service-content">
                        <h3>Denting &amp; Painting</h3>

                        <p>
                            Professional bodywork, repairs and resprays.
                        </p>

                        <a href="#" class="ss-service-link">
                            Explore Bodywork →
                        </a>
                    </div>

                </div>
            </div>

        </div>

    </div>
</section>


<!-- =========================
     ABOUT SECTION
========================= -->
<section id="about" class="ss-about-section">

    <div class="container">

        <div class="row align-items-center g-5">

            <div class="col-lg-6">

                <span class="ss-about-label">
                    ABOUT SSAUTONATION
                </span>

                <h2>
                    More Than Just Cars.
                    <span>It's Everything Automotive.</span>
                </h2>

                <p>
                    SSAutonation is built around one simple idea —
                    making automotive services easier to discover,
                    access and trust.
                </p>

                <p>
                    Whether you're looking to buy a vehicle, find the
                    right parts, maintain your car, replace your tyres
                    or repair bodywork, we're bringing it all together
                    under one automotive platform.
                </p>

                <a href="#" class="btn ss-btn-primary">
                    Learn More
                </a>

            </div>

            <div class="col-lg-6">

                <div class="ss-about-highlight">

                    <div>
                        <strong>6</strong>
                        <span>Automotive Services</span>
                    </div>

                    <div>
                        <strong>1</strong>
                        <span>Automotive Platform</span>
                    </div>

                    <div>
                        <strong>∞</strong>
                        <span>Possibilities</span>
                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================
     CALL TO ACTION
========================= -->
<section class="ss-cta-section">

    <div class="container">

        <div class="ss-cta-content">

            <span>READY TO GET STARTED?</span>

            <h2>
                Everything Automotive.
                <br />
                All in One Place.
            </h2>

            <p>
                Explore SSAutonation and discover a smarter way
                to manage your automotive needs.
            </p>

            <a href="#services" class="btn ss-btn-primary">
                Explore SSAutonation
            </a>

        </div>

    </div>

</section>
