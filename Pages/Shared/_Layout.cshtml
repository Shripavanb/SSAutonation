<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="description"
          content="SS Autonation - Your automotive destination for vehicles, auto parts, servicing, tyres, denting and painting, and automotive news." />

    <meta name="keywords"
          content="cars, vehicles, auto traders, auto parts, car servicing, tyres, denting painting, automotive UK, SS Autonation" />

    <meta name="author" content="SS Autonation" />

    <title>@ViewData["Title"] - SS Autonation</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

          <link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Site CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <!-- ASP.NET Core generated styles -->
    <link rel="stylesheet"
          href="~/SSAutonation.styles.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <!-- =========================
         TOP BAR
         ========================= -->

    <div class="ss-topbar">
        <div class="container ss-container">

            <div class="ss-topbar-left">
                <span>
                    <i class="bi bi-geo-alt"></i>
                    United Kingdom
                </span>

                <span>
                    <i class="bi bi-envelope"></i>
                    info@ssautonation.co.uk
                </span>
            </div>

            <div class="ss-topbar-right">
                <span>Everything Automotive. Under One Roof.</span>
            </div>

        </div>
    </div>


    <!-- =========================
         MAIN NAVIGATION
         ========================= -->

    <header class="ss-header">

        <nav class="navbar navbar-expand-lg">

            <div class="container ss-container">

                <!-- BRAND -->

                <a class="navbar-brand ss-brand"
                   asp-area=""
                   asp-page="/Index">

                    <span class="ss-brand-main">
                        <img src="~/img/logo.png" />
                    </span>

                    <span class="ss-brand-text">
                        <strong>SS AUTONATION</strong>
                        <small>Everything Automotive</small>
                    </span>

                </a>


                <!-- MOBILE MENU BUTTON -->

                <button class="navbar-toggler ss-navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span></span>
                    <span></span>
                    <span></span>

                </button>


                <!-- NAVIGATION -->

                <div class="collapse navbar-collapse"
                     id="mainNavigation">

                    <ul class="navbar-nav ms-auto align-items-lg-center">


                        <!-- HOME -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-area=""
                               asp-page="/Index">

                                Home

                            </a>

                        </li>


                        <!-- AUTO TRADERS -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-area=""
                               asp-page="/Traders/Index">

                                Auto Traders

                            </a>

                        </li>


                        <!-- SERVICES DROPDOWN -->

                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">

                                Services

                            </a>

                            <ul class="dropdown-menu ss-dropdown">

                                <li>
                                    <a class="dropdown-item"
                                       asp-page="/Services/Index">
                                        Auto Services
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-page="/Tyres/Index">
                                        Tyres
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-page="/Bodywork/Index">
                                        Denting & Painting
                                    </a>
                                </li>

                            </ul>

                        </li>


                        <!-- AUTO PARTS -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-area=""
                               asp-page="/Parts/Index">

                                Auto Parts

                            </a>

                        </li>


                        <!-- MAGAZINE -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-area=""
                               asp-page="/Magazine/Index">

                                Magazine

                            </a>

                        </li>


                        <!-- ABOUT -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-area=""
                               asp-page="/AboutUs">

                                About

                            </a>

                        </li>


                        <!-- CONTACT BUTTON -->

                        <li class="nav-item ss-nav-cta">

                            <a class="nav-link"
                               asp-area=""
                               asp-page="/Contact">

                                Contact Us

                            </a>

                        </li>

                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <!-- =========================
         MAIN CONTENT
         ========================= -->

    <main role="main">

        @RenderBody()

    </main>


    <!-- =========================
         FOOTER
         ========================= -->

    <footer class="ss-footer">

        <div class="container ss-container">

            <div class="row gy-5">


                <!-- COMPANY -->

                <div class="col-lg-4 col-md-6">

                    <div class="ss-footer-brand">

                        <div class="ss-footer-logo">
                            SS
                        </div>

                        <div>
                            <strong>SS AUTONATION</strong>
                            <small>Everything Automotive</small>
                        </div>

                    </div>

                    <p class="ss-footer-description">

                        Your automotive destination for vehicles,
                        servicing, parts, tyres, bodywork and
                        automotive information.

                    </p>


                    <div class="ss-social-links">

                        <a href="#"
                           aria-label="Facebook">
                            <i class="bi bi-facebook"></i>
                        </a>

                        <a href="#"
                           aria-label="Instagram">
                            <i class="bi bi-instagram"></i>
                        </a>

                        <a href="#"
                           aria-label="YouTube">
                            <i class="bi bi-youtube"></i>
                        </a>

                        <a href="#"
                           aria-label="LinkedIn">
                            <i class="bi bi-linkedin"></i>
                        </a>

                    </div>

                </div>


                <!-- QUICK LINKS -->

                <div class="col-lg-2 col-md-6">

                    <h5>Quick Links</h5>

                    <ul class="ss-footer-links">

                        <li>
                            <a asp-page="/Index">
                                Home
                            </a>
                        </li>

                        <li>
                            <a asp-page="/AboutUs">
                                About Us
                            </a>
                        </li>

                        <li>
                            <a asp-page="/Contact">
                                Contact
                            </a>
                        </li>

                        <li>
                            <a asp-page="/Privacy">
                                Privacy
                            </a>
                        </li>

                        <li>
                            <a asp-page="/Terms">
                                Terms
                            </a>
                        </li>

                    </ul>

                </div>


                <!-- SERVICES -->

                <div class="col-lg-3 col-md-6">

                    <h5>Our Services</h5>

                    <ul class="ss-footer-links">

                        <li>
                            <a asp-page="/Traders/Index">
                                Auto Traders
                            </a>
                        </li>

                        <li>
                            <a asp-page="/Services/Index">
                                Auto Services
                            </a>
                        </li>

                        <li>
                            <a asp-page="/Parts/Index">
                                Auto Parts
                            </a>
                        </li>

                        <li>
                            <a asp-page="/Tyres/Index">
                                Tyres
                            </a>
                        </li>

                        <li>
                            <a asp-page="/Bodywork/Index">
                                Denting & Painting
                            </a>
                        </li>

                        <li>
                            <a asp-page="/Magazine/Index">
                                Auto Magazine
                            </a>
                        </li>

                    </ul>

                </div>


                <!-- CONTACT -->

                <div class="col-lg-3 col-md-6">

                    <h5>Get In Touch</h5>

                    <ul class="ss-contact-list">

                        <li>
                            <span class="ss-contact-icon">
                                <i class="bi bi-geo-alt"></i>
                            </span>

                            <span>
                                United Kingdom
                            </span>
                        </li>

                        <li>
                            <span class="ss-contact-icon">
                                <i class="bi bi-envelope"></i>
                            </span>

                            <span>
                                info@ssautonation.co.uk
                            </span>
                        </li>

                        <li>
                            <span class="ss-contact-icon">
                                <i class="bi bi-telephone"></i>
                            </span>

                            <span>
                                Contact us for enquiries
                            </span>
                        </li>

                    </ul>

                </div>

            </div>


            <!-- FOOTER BOTTOM -->

<div class="ss-footer-bottom">
    <div class="ss-container ss-footer-bottom-inner">

        <div class="ss-footer-copy">
            &copy; @DateTime.Now.Year SSAutonation. All rights reserved.
        </div>

        <div class="ss-footer-powered">
            Powered by
            <a href="https://shriaitech.in" target="_blank" rel="noopener">
                ShriAiTech
            </a>
        </div>

        <div class="ss-footer-legal">
            <a asp-page="/Privacy">Privacy</a>
            <span> | </span>
            <a asp-page="/Terms">Terms</a>
        </div>

    </div>
</div>

        </div>

    </footer>


    <!-- =========================
         SCRIPTS
         ========================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>